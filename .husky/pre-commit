#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Checking code quality before commit"

# 1. Frontend (Bun) - używamy --cwd, żeby nie zmieniać folderu skryptu
echo "⚡ Linting frontend..."
bun --cwd apps/neuro-chord-frontend lint || exit 1

# 2. Backend (.NET) - ścieżka od roota repozytorium
echo "🛠️ Checking backend format..."
dotnet format ./apps/neuro-chord-prod-backend/neuro-chord-prod-backend.sln --verify-no-changes || exit 1

echo "✅ All checks passed!"