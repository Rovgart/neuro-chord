{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@modules/*": ["src/modules/*"],
      "@prisma/*": ["src/common/infrastructure/prisma/*"],
      "@redis/*": ["src/common/infrastructure/redis/*"],
      "@mongo/*": ["src/common/infrastructure/mongo/*"],
      "@strategies/*": ["src/common/shared/strategies/*"],
      "@mailer/*": ["src/common/infrastructure/mailer/*"],
      "@decorators/*": ["src/common/shared/decorators/*"],
      "@guards/*": ["src/common/shared/guards/*"],
      "@interceptors/*": ["src/common/shared/interceptors/*"],
      "@DTOs/*": ["src/common/shared/dto/*"],
      "@filters/*": ["src/common/shared/filters/*"],
      "@pipes/*": ["src/common/shared/pipes/*"],
      "@utils/*": ["src/common/utils/*"],
      "@config/*": ["src/config/*"],
      "@stats/*": ["src/common/infrastructure/stats/*"],
      "@security/*": ["src/common/infrastructure/security/*"],
      "@session/*": ["src/common/infrastructure/session/*"],
      "@templates/*": ["src/templates/*"],

      "@types/*": ["src/types/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
