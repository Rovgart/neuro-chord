@model dynamic
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to NeuroChord</title>
</head>
<body
    style="margin: 0; padding: 0; font-family: 'Inter', 'Segoe UI', Helvetica, Arial, sans-serif; background-color: #f9fafb; color: #111827;">
<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%"
       style="max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
    <tr>
        <td style="padding: 40px 0; text-align: center; background-color: #000000;">
            <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase;">
                NeuroChord</h1>
        </td>
    </tr>

    <tr>
        <td style="padding: 48px 40px;">
            <h2 style="margin-top: 0; color: #111827; font-size: 24px; font-weight: 700;">Welcome !</h2>
            <p style="font-size: 16px; line-height: 1.7; color: #4b5563; margin-top: 16px;">
                We're thrilled to have you on board. <strong>NeuroChord</strong> is designed to streamline your workflow
                and harmonize your data management. Your account is ready and waiting.
            </p>

            <table border="0" cellpadding="0" cellspacing="0" style="margin: 32px 0;">
                <tr>
                    <td align="center" style="border-radius: 6px; background-color: #2563eb;">
                        <a href="@Model.ActivationLink" target="_blank"
                           style="padding: 14px 28px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; display: inline-block;">
                            Activate Your Account
                        </a>
                    </td>
                </tr>
            </table>

            <p style="font-size: 14px; color: #6b7280; line-height: 1.5; margin-top: 32px; border-top: 1px solid #f3f4f6; padding-top: 24px;">
                If the button above doesn't work, copy and paste this link into your browser:<br>
                <a href="@Model.ActivationLink" style="color: #2563eb; word-break: break-all;">@Model.ActivationLink</a>
            </p>
        </td>
    </tr>

    <tr>
        <td style="padding: 32px 40px; background-color: #f9fafb; text-align: center; font-size: 12px; color: #9ca3af;">
            <p style="margin: 0; font-weight: 600;">&copy; 2026 NeuroChord System</p>
            <p style="margin: 8px 0 0;">You received this email because you signed up for NeuroChord.</p>
            <p style="margin: 4px 0 0;">Rzeszów, Poland</p>
        </td>
    </tr>
</table>
</body>
</html>