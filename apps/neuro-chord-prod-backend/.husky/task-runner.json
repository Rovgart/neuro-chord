{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "format",
            "apps/neuro-chord-prod-backend/neuro-chord-prod-backend.sln", // <--- Dodaj to!
            "--verify-no-changes"
         ],
         "include": ["**/*.cs"]
      },
      {
         "name": "check-unused-usings",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "build",
            "apps/neuro-chord-prod-backend/neuro-chord-prod-backend.sln", // <--- I tutaj
            "/warnaserror"
         ],
         "include": ["**/*.cs"]
      },
      {
         "name": "check-unused-usings",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "build",
            "apps/neuro-chord-prod-backend/neuro-chord-prod-backend.sln", // ŚCIEŻKA DO SLN
            "/warnaserror"
         ],
         "include": ["**/*.cs"]
      },
      {
         "name": "gitleaks",
         "group": "pre-commit",
         "command": "gitleaks",
         "args": ["protect", "--staged"]
      }
   ]
}