{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": ["format", "--verify-no-changes"],
         "include": ["**/*.cs"]
      },
      {
         "name": "dotnet-test",
         "group": "pre-commit",
         "command": "dotnet",
         "args": ["test", "--no-restore", "--verbosity", "quiet"],
         "include": ["**/*.cs"]
      },
      {
         "name": "check-unused-usings",
         "group": "pre-commit",
         "command": "dotnet",
         "args": ["build", "/warnaserror"],
         "include": ["**/*.cs"]
      },
      {
          "name": "gitleaks",
          "group": "pre-commit", // <-- Dodaj to!
          "command": "gitleaks",
          "args": ["protect", "--staged"]
      }
   ]
}
